# ─────────────────────────────────────────────────────────────────────────────
# Heat Risk Agent — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Temperature data source ───────────────────────────────────────────────────
# Options: simulate | open_meteo | fortyguard
# "simulate" works with no keys. "open_meteo" uses the free Open-Meteo API (no key).
# "fortyguard" requires FORTYGUARD_API_KEY below.
TEMP_DATA_MODE=simulate

# Options: auto | simulate. Use simulate with TEMP_DATA_MODE=simulate for a
# source-consistent offline demo with no network calls.
DEMAND_DATA_MODE=auto

# FortyGuard Temperature API key (only needed when TEMP_DATA_MODE=fortyguard)
FORTYGUARD_API_KEY=your_fortyguard_api_key_here

# ── Electricity demand source ─────────────────────────────────────────────────
# Default: ERCOT public data (no key needed).
# Set EIA_API_KEY to enable EIA fallback.
EIA_API_KEY=your_eia_api_key_here

# ── Agent configuration ───────────────────────────────────────────────────────
# Risk score threshold (0-100): agent alerts when score exceeds this value.
RISK_THRESHOLD=70

# How often the agent polls for new data (seconds). 300 = every 5 minutes.
AGENT_POLL_INTERVAL_SECONDS=300

# Minimum time between repeated alerts for the same high-risk event (minutes).
ALERT_COOLDOWN_MINUTES=60

# ── Alert backends ────────────────────────────────────────────────────────────
# Comma-separated list of active alert backends: log, slack
ALERT_BACKENDS=log,slack

# Slack incoming webhook URL (only needed when "slack" is in ALERT_BACKENDS)
SLACK_WEBHOOK_URL=https://example.com/fake-slack-webhook

# ── Data & region settings ────────────────────────────────────────────────────
# Target ERCOT region for demand data. ERCOT exposes: COAST, EAST, FAR_WEST,
# NORTH, NORTH_C, SOUTHERN, SOUTH_C, WEST, TOTAL
ERCOT_REGION=COAST

# City coordinates used by Open-Meteo / simulation center (Houston, TX default)
LOCATION_LAT=29.7604
LOCATION_LON=-95.3698
LOCATION_NAME=Houston_TX
